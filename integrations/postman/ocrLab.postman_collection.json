{
  "info": {
    "_postman_id": "a98dfb01-4c12-4982-b715-9f5b248e3a19",
    "name": "Unlimited OCR Cloud API (v1)",
    "description": "Postman Collection for Unlimited OCR Cloud (Baidu Unlimited-OCR-2 & PyMuPDF)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/v1",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "ocr_live_replace_with_your_key",
      "type": "string"
    },
    {
      "key": "lastJobId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public Health Check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Upload Document & Create Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 202) {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set('lastJobId', json.job_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Idempotency-Key", "value": "test-uuid-{{$timestamp}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "mode", "value": "auto", "type": "text" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/documents", "host": ["{{baseUrl}}"], "path": ["documents"] }
      }
    },
    {
      "name": "Get Job Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/jobs/{{lastJobId}}", "host": ["{{baseUrl}}"], "path": ["jobs", "{{lastJobId}}"] }
      }
    },
    {
      "name": "Get Structured JSON Result",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{lastJobId}}/result?format=json",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{lastJobId}}", "result"],
          "query": [{ "key": "format", "value": "json" }]
        }
      }
    },
    {
      "name": "Get Markdown Result",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{lastJobId}}/result?format=markdown",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{lastJobId}}", "result"],
          "query": [{ "key": "format", "value": "markdown" }]
        }
      }
    },
    {
      "name": "Get Plain Text Result",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{lastJobId}}/result?format=text",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{lastJobId}}", "result"],
          "query": [{ "key": "format", "value": "text" }]
        }
      }
    },
    {
      "name": "Get Usage and Quotas",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/usage", "host": ["{{baseUrl}}"], "path": ["usage"] }
      }
    },
    {
      "name": "Delete Job and Purge Document",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/jobs/{{lastJobId}}", "host": ["{{baseUrl}}"], "path": ["jobs", "{{lastJobId}}"] }
      }
    }
  ]
}
