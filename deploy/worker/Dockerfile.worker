# ==============================================================================
# Unlimited OCR Cloud — Layer B GPU Inference Worker
# Base: NVIDIA CUDA 12.4 + PyTorch 2.4.0 Runtime
# Invariant: Connects strictly OUTBOUND over HTTPS to Layer A Control Plane.
#            NO OPEN INBOUND INFERENCE PORTS.
# ==============================================================================

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0" \
    TRANSFORMERS_CACHE=/workspace/models \
    HF_HOME=/workspace/models

WORKDIR /workspace

# Install system dependencies (build-essential, git, libmupdf, curl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages required for Route A (PyMuPDF) and Route B (Unlimited-OCR-2)
RUN pip install --no-cache-dir \
    "pymupdf>=1.24.0,<2.0.0" \
    "pillow>=10.0.0" \
    "httpx>=0.27.0" \
    "pydantic>=2.7.0" \
    "tenacity>=8.2.0" \
    "transformers>=4.40.0" \
    "accelerate>=0.30.0" \
    "sentencepiece>=0.2.0" \
    "timm>=1.0.0"

# Copy worker application code
COPY worker/ /workspace/worker/
COPY sdks/python/unlimited_ocr/ /workspace/unlimited_ocr/

# Create non-root runner user with access to GPU
RUN useradd -m -u 10002 workeruser && \
    mkdir -p /workspace/models /workspace/scratch && \
    chown -R workeruser:workeruser /workspace

USER workeruser

# The worker does NOT expose any inbound ports.
# It polls the control plane outbound over HTTPS.

CMD ["python", "-m", "worker.worker_daemon"]
