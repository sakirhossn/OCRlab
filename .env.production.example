# ==============================================================================
# Unlimited OCR Cloud — Production Environment Configuration Template
# Generate secure keys using: openssl rand -hex 32
# ==============================================================================

# Public Host Domain (used for Caddy TLS certificate provisioning)
APP_DOMAIN=ocr.example.com
ACME_EMAIL=admin@example.com

# FastAPI Application Security
ENVIRONMENT=production
LOG_LEVEL=INFO
# Master application secret (min 32 bytes)
SECRET_KEY=change_this_to_a_random_64_character_hex_string_generate_with_openssl

# AES-256-GCM Document Storage Encryption Key (Exact 32 bytes = 64 hex characters)
STORAGE_VAULT_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# PostgreSQL Database Credentials
POSTGRES_USER=ocr_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password_min_32_chars
POSTGRES_DB=ocr_cloud

# Worker Lease Authentication Shared Secret (Workers use this in HTTP Authorization header)
WORKER_SECRET_KEY=change_this_to_another_random_64_character_hex_secret

# Rate Limiting & Quotas Defaults
DEFAULT_BURST_RATE_LIMIT=120
DEFAULT_MONTHLY_PAGE_QUOTA=50000

# File Upload Hard Limits
MAX_PDF_SIZE_MB=64
MAX_PDF_PAGES=500
MAX_IMAGE_DIMENSION_PX=4096
